{
  "name": "skyrim-rp-launcher",
  "version": "0.1.26",
  "private": true,
  "description": "Frostveil Skyrim Multiplayer RP Launcher",
  "author": "Skyrim RP project",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node scripts/tests.mjs",
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "package:dir": "npm run build && electron-builder --win dir --publish never",
    "package:nsis": "npm run build && electron-builder --win nsis --publish never",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "builder-util-runtime": "9.7.0",
    "electron-updater": "6.8.9",
    "js-yaml": "4.3.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "semver": "7.8.5",
    "vdf-parser": "1.2.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/js-yaml": "4.0.9",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "@types/semver": "7.8.0",
    "electron": "44.7.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "build": {
    "appId": "dev.skyrimrp.launcher",
    "productName": "Skyrim RP Launcher",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "assets/**",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "SkyrimRPLauncher-${version}-${arch}-local.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "kaktv2016",
      "repo": "frostveil-launcher",
      "private": false,
      "releaseType": "release"
    }
  }
}
